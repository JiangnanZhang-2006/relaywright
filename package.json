{
  "name": "relaywright",
  "version": "0.1.0-rc.1",
  "description": "Chromium browser control for agents, with an MCP server and a CLI sharing one local daemon.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/dsh/plugin.js",
  "bin": {
    "relaywright": "dist/cli/index.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepare": "tsc",
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.bench.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bench": "tsx bench/run.ts",
    "licenses": "node scripts/check-licenses.mjs"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.1 <0.2.2",
    "@hono/node-server": "^2.1.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@puppeteer/browsers": "^3.2.5",
    "commander": "^15.0.0",
    "hono": "^4.13.13",
    "puppeteer-core": "^25.15.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
